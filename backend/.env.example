# Copy to .env and adjust. All values have safe local defaults.

# SQLAlchemy URL. SQLite file path relative to the backend/ directory.
DATABASE_URL=sqlite:///./route53.db

# Random string used for signing. Generate one for production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Set to true behind HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=false

# JSON list of origins allowed by CORS (only needed if not using the Next.js proxy).
ALLOWED_ORIGINS=["http://localhost:3000"]

# Seed the demo user and hosted zones when the database is empty.
SEED_ON_STARTUP=true
